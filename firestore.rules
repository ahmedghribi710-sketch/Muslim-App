rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile Validation
    function isValidUserProfile(data, userId) {
      return data.userId == userId &&
        data.studentName is string && data.studentName.size() <= 80 &&
        data.selectedCity is string && data.selectedCity.size() <= 60;
    }

    // Homework Item Validation
    function isValidHomework(data, userId) {
      return data.userId == userId &&
        data.id is string && data.id.size() <= 128 &&
        data.subject is string && data.subject.size() <= 60 &&
        data.title is string && data.title.size() <= 200 &&
        data.dueDate is string && data.dueDate.size() <= 30 &&
        data.status in ['pending', 'in_progress', 'completed'];
    }

    // School Class Validation
    function isValidSchoolClass(data, userId) {
      return data.userId == userId &&
        data.id is string && data.id.size() <= 128 &&
        data.day is string && data.day.size() <= 20 &&
        data.startTime is string && data.startTime.size() <= 10 &&
        data.endTime is string && data.endTime.size() <= 10 &&
        data.subject is string && data.subject.size() <= 60;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidUserProfile(incoming(), userId) && incoming().userId == existing().userId;
      allow delete: if false;

      match /homework/{homeworkId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(homeworkId) && isValidHomework(incoming(), userId);
        allow update: if isOwner(userId) && isValidHomework(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }

      match /classes/{classId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(classId) && isValidSchoolClass(incoming(), userId);
        allow update: if isOwner(userId) && isValidSchoolClass(incoming(), userId) && incoming().userId == existing().userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
